<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WinUIForge.Port.App</RootNamespace>
    <AssemblyName>WinUIForge.Port.App</AssemblyName>
    <ApplicationIcon>..\..\assets\workshop-ui\app-icon\Workshop.ico</ApplicationIcon>
    <Win32Icon>..\..\assets\workshop-ui\app-icon\Workshop.ico</Win32Icon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="WinUIEdit" Version="0.0.5-prerelease" />
    <ProjectReference Include="../WinUIForge.Port.Core/WinUIForge.Port.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\gallery-toolbox.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\workshop-ui\app-icon\Workshop.ico"
          Link="Workshop.ico"
          TargetPath="Workshop.ico"
          CopyToOutputDirectory="Always"
          CopyToPublishDirectory="Always" />
    <Content Include="..\..\assets\workshop-ui\runtime\navigation\*.png"
             Link="Assets\WorkshopUi\Navigation\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\benchmarks\workshop-dashboard-v1\Screen.xaml"
             Link="Benchmarks\workshop-dashboard-v1\Screen.xaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\benchmarks\workshop-dashboard-v1\Screen.forge.json"
             Link="Benchmarks\workshop-dashboard-v1\Screen.forge.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\benchmarks\workshop-storage-settings-v1\Screen.xaml"
             Link="Benchmarks\workshop-storage-settings-v1\Screen.xaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\benchmarks\workshop-storage-settings-v1\Screen.forge.json"
             Link="Benchmarks\workshop-storage-settings-v1\Screen.forge.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
