<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="WorkshopStorageSettingsBenchmark"
      Background="#111417">
    <Grid.Resources>
        <SolidColorBrush x:Key="ShellBrush" Color="#111417"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#171B1F"/>
        <SolidColorBrush x:Key="CardBrush" Color="#1D2227"/>
        <SolidColorBrush x:Key="ElevatedBrush" Color="#22282E"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#30373F"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#F97316"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9BA3AD"/>
        <SolidColorBrush x:Key="GoodBrush" Color="#42C889"/>
        <SolidColorBrush x:Key="BlueBrush" Color="#4EA2FF"/>
        <SolidColorBrush x:Key="PurpleBrush" Color="#A96CF4"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#F2A63A"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#F0525D"/>
    </Grid.Resources>

    <Grid.RowDefinitions>
        <RowDefinition Height="60"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="66"/>
        <RowDefinition Height="68"/>
    </Grid.RowDefinitions>

    <!-- Global shell -->
    <Border x:Name="TopCommandBar"
            Grid.Row="0"
            Background="#13171B"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
        <Grid Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                <Border Width="34"
                        Height="34"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="5">
                    <TextBlock Text="◇"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#17191B"
                               FontSize="18"
                               FontWeight="Bold"/>
                </Border>
                <TextBlock Text="Workshop"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="23"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Border Width="1"
                        Height="34"
                        Margin="4,0"
                        Background="{StaticResource BorderBrush}"/>
                <StackPanel VerticalAlignment="Center"
                            Spacing="-1">
                    <TextBlock Text="Storage &amp; Settings"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="17"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Storage management, preferences and workspace configuration"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Stretch"
                        Spacing="8">
                <Grid Width="88">
                    <Image Source="ms-appx:///Assets/WorkshopUi/Navigation/Dashboard.png" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,7,0,0" Opacity="0.72" Stretch="Uniform"/>
                    <TextBlock Text="Dashboard" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,7" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                </Grid>
                <Grid Width="88">
                    <Image Source="ms-appx:///Assets/WorkshopUi/Navigation/Prepare.png" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,7,0,0" Opacity="0.72" Stretch="Uniform"/>
                    <TextBlock Text="Prepare" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,7" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                </Grid>
                <Grid Width="88">
                    <Image Source="ms-appx:///Assets/WorkshopUi/Navigation/Conduit.png" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,7,0,0" Opacity="0.72" Stretch="Uniform"/>
                    <TextBlock Text="Conduit" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,7" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                </Grid>
                <Grid Width="88">
                    <Image Source="ms-appx:///Assets/WorkshopUi/Navigation/Beacon.png" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,7,0,0" Opacity="0.72" Stretch="Uniform"/>
                    <TextBlock Text="Beacon" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,7" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                </Grid>
                <Grid Width="88">
                    <Image Source="ms-appx:///Assets/WorkshopUi/Navigation/Library.png" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,7,0,0" Opacity="0.72" Stretch="Uniform"/>
                    <TextBlock Text="Library" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,7" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                </Grid>
                <Grid Width="88">
                    <Border Background="#2B211B"
                            BorderBrush="#66371F"
                            BorderThickness="1"
                            CornerRadius="5"/>
                    <Image Source="ms-appx:///Assets/WorkshopUi/Navigation/Settings.png" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,7,0,0" Stretch="Uniform"/>
                    <TextBlock Text="Settings" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,7" Foreground="{StaticResource AccentBrush}" FontSize="12"/>
                    <Border Height="2" VerticalAlignment="Bottom" Background="{StaticResource AccentBrush}"/>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Spacing="18">
                <TextBlock Text="—" Foreground="{StaticResource AccentBrush}" FontSize="18"/>
                <TextBlock Text="▢" Foreground="{StaticResource MutedBrush}" FontSize="16"/>
                <TextBlock Text="×" Foreground="{StaticResource TextBrush}" FontSize="20"/>
            </StackPanel>
        </Grid>
    </Border>

    <!-- Main workspace -->
    <Grid x:Name="SettingsWorkspace"
          Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="188"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- Settings navigation -->
        <Border x:Name="SettingsNavigation"
                Grid.Column="0"
                Margin="8,8,0,0"
                Background="#15191D"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel Padding="8"
                        Spacing="4">
                <Border x:Name="GeneralNavItem"
                        HorizontalAlignment="Stretch"
                        Padding="10,8"
                        Background="#5A3928"
                        BorderBrush="#774725"
                        BorderThickness="1"
                        CornerRadius="5">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="⚙" Foreground="{StaticResource AccentBrush}" FontSize="16"/>
                        <TextBlock Text="General" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Button Content="◉   Appearance" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8" Background="Transparent" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                <Button Content="□   Paths" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8" Background="Transparent" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                <Button Content="▱   Storage" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8" Background="Transparent" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                <Button Content="⚙   Workers" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8" Background="Transparent" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                <Button Content="▥   Performance" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8" Background="Transparent" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                <Button Content="⌘   Integrations" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8" Background="Transparent" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                <Button Content="♙   Accounts" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8" Background="Transparent" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                <Button Content="◈   Security" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8" Background="Transparent" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                <Button Content="♧   Notifications" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8" Background="Transparent" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                <Button Content="▱   Backups" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8" Background="Transparent" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                <Button Content="ⓘ   About" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8" Background="Transparent" Foreground="{StaticResource TextBrush}" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- Centre settings surface -->
        <Grid x:Name="SettingsMain"
              Grid.Column="1"
              Margin="8,8,8,0"
              RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="184"/>
                <RowDefinition Height="374"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Storage overview -->
            <Border x:Name="StorageOverviewPanel"
                    Grid.Row="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="74"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center">
                        <TextBlock Text="▱" Foreground="{StaticResource TextBrush}" FontSize="23"/>
                        <TextBlock Text="Storage Overview"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <Grid Grid.Row="1"
                          ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="TotalUsageCard"
                                Padding="13,9"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Total Usage" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                <Grid Grid.Row="1">
                                    <TextBlock Text="1.24 TB / 4.00 TB"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <StackPanel HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Spacing="3">
                                        <TextBlock Text="31%" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="9"/>
                                        <Grid Width="114" Height="11" Background="#30363D">
                                            <Border Width="35" HorizontalAlignment="Left" Background="{StaticResource BlueBrush}"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border x:Name="ProjectsStorageCard"
                                Grid.Column="1"
                                Padding="11,8"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <TextBlock Text="□" Foreground="{StaticResource BlueBrush}" FontSize="20"/>
                                    <TextBlock Text="Projects" Foreground="{StaticResource TextBrush}" FontSize="11"/>
                                </StackPanel>
                                <Grid>
                                    <TextBlock Text="612 GB" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="49%" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="9"/>
                                </Grid>
                                <Grid Height="5" Background="#30363D">
                                    <Border Width="48" HorizontalAlignment="Left" Background="{StaticResource BlueBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="AssetsStorageCard"
                                Grid.Column="2"
                                Padding="11,8"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <TextBlock Text="⬡" Foreground="{StaticResource GoodBrush}" FontSize="20"/>
                                    <TextBlock Text="Assets Library" Foreground="{StaticResource TextBrush}" FontSize="11"/>
                                </StackPanel>
                                <Grid>
                                    <TextBlock Text="428 GB" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="34%" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="9"/>
                                </Grid>
                                <Grid Height="5" Background="#30363D">
                                    <Border Width="36" HorizontalAlignment="Left" Background="{StaticResource GoodBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CacheStorageCard"
                                Grid.Column="3"
                                Padding="11,8"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <TextBlock Text="▣" Foreground="{StaticResource AccentBrush}" FontSize="20"/>
                                    <TextBlock Text="Cache &amp; Temp" Foreground="{StaticResource TextBrush}" FontSize="11"/>
                                </StackPanel>
                                <Grid>
                                    <TextBlock Text="142 GB" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="11%" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="9"/>
                                </Grid>
                                <Grid Height="5" Background="#30363D">
                                    <Border Width="13" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="BackupsStorageCard"
                                Grid.Column="4"
                                Padding="11,8"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <TextBlock Text="▰" Foreground="{StaticResource PurpleBrush}" FontSize="20"/>
                                    <TextBlock Text="Backups" Foreground="{StaticResource TextBrush}" FontSize="11"/>
                                </StackPanel>
                                <Grid>
                                    <TextBlock Text="58 GB" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="5%" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="9"/>
                                </Grid>
                                <Grid Height="5" Background="#30363D">
                                    <Border Width="7" HorizontalAlignment="Left" Background="{StaticResource PurpleBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="2"
                               Margin="0,8,0,4"
                               Text="Key Locations"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"/>

                    <Grid x:Name="KeyLocationsPanel"
                          Grid.Row="3"
                          ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Padding="10,7" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="□" Foreground="{StaticResource AccentBrush}" FontSize="19"/>
                                <StackPanel Grid.Column="1" Margin="8,0" Spacing="-1">
                                    <TextBlock Text="Projects" Foreground="{StaticResource TextBrush}" FontSize="10"/>
                                    <TextBlock Text="D:\Projects\Workshop" Foreground="{StaticResource MutedBrush}" FontSize="8"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="⋯" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Padding="10,7" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="⬡" Foreground="{StaticResource GoodBrush}" FontSize="19"/>
                                <StackPanel Grid.Column="1" Margin="8,0" Spacing="-1">
                                    <TextBlock Text="Assets Library" Foreground="{StaticResource TextBrush}" FontSize="10"/>
                                    <TextBlock Text="D:\Assets\Library" Foreground="{StaticResource MutedBrush}" FontSize="8"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="⋯" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Padding="10,7" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="▣" Foreground="{StaticResource AccentBrush}" FontSize="19"/>
                                <StackPanel Grid.Column="1" Margin="8,0" Spacing="-1">
                                    <TextBlock Text="Cache" Foreground="{StaticResource TextBrush}" FontSize="10"/>
                                    <TextBlock Text="C:\Users\jla3d\AppData\Local\Workshop\Cache" Foreground="{StaticResource MutedBrush}" FontSize="8" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="⋯" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="3" Padding="10,7" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="▰" Foreground="{StaticResource PurpleBrush}" FontSize="19"/>
                                <StackPanel Grid.Column="1" Margin="8,0" Spacing="-1">
                                    <TextBlock Text="Backups" Foreground="{StaticResource TextBrush}" FontSize="10"/>
                                    <TextBlock Text="D:\Backups\Workshop" Foreground="{StaticResource MutedBrush}" FontSize="8"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="⋯" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Application settings -->
            <Border x:Name="ApplicationSettingsPanel"
                    Grid.Row="1"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal"
                                Spacing="0">
                        <Border Width="160"
                                Background="#30231C"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="0,0,0,2">
                            <TextBlock Text="Application Settings"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </Border>
                        <Border Width="155">
                            <TextBlock Text="Storage Management"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"/>
                        </Border>
                        <Border Width="135">
                            <TextBlock Text="Backup &amp; Restore"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"/>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="1"
                          Padding="14,10"
                          ColumnSpacing="22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="0.78*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="GeneralSettingsColumn"
                                    Grid.Column="0"
                                    Spacing="7">
                            <TextBlock Text="General" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold"/>
                            <Grid><TextBlock Text="Start Workshop at login" Foreground="{StaticResource TextBrush}" FontSize="10"/><ToggleSwitch HorizontalAlignment="Right" IsOn="True" OnContent="On" OffContent="Off"/></Grid>
                            <Grid><TextBlock Text="Check for updates automatically" Foreground="{StaticResource TextBrush}" FontSize="10"/><ToggleSwitch HorizontalAlignment="Right" IsOn="True" OnContent="On" OffContent="Off"/></Grid>
                            <Grid><TextBlock Text="Send anonymous usage data" Foreground="{StaticResource TextBrush}" FontSize="10"/><ToggleSwitch HorizontalAlignment="Right" IsOn="False" OnContent="On" OffContent="Off"/></Grid>
                            <Grid><TextBlock Text="Show welcome screen" Foreground="{StaticResource TextBrush}" FontSize="10"/><ToggleSwitch HorizontalAlignment="Right" IsOn="True" OnContent="On" OffContent="Off"/></Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Default workspace" Foreground="{StaticResource TextBrush}" FontSize="10"/>
                                <ComboBox Grid.Column="1" SelectedIndex="0">
                                    <ComboBoxItem Content="Dashboard"/>
                                    <ComboBoxItem Content="Library"/>
                                </ComboBox>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Language" Foreground="{StaticResource TextBrush}" FontSize="10"/>
                                <ComboBox Grid.Column="1" SelectedIndex="0">
                                    <ComboBoxItem Content="English (US)"/>
                                    <ComboBoxItem Content="English (UK)"/>
                                </ComboBox>
                            </Grid>

                            <Border Height="1" Margin="0,4" Background="{StaticResource BorderBrush}"/>
                            <TextBlock Text="Appearance" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Theme" Foreground="{StaticResource TextBrush}" FontSize="10"/>
                                <ComboBox Grid.Column="1" SelectedIndex="0">
                                    <ComboBoxItem Content="Dark (Workshop)"/>
                                    <ComboBoxItem Content="System"/>
                                </ComboBox>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Accent color" Foreground="{StaticResource TextBrush}" FontSize="10"/>
                                <Border Grid.Column="1" Height="30" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0" VerticalAlignment="Center">
                                        <Border Width="17" Height="12" Background="{StaticResource AccentBrush}" CornerRadius="2"/>
                                        <TextBlock Text="Orange (Default)" Foreground="{StaticResource TextBrush}" FontSize="9"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                                <TextBlock Text="UI scale" Foreground="{StaticResource TextBrush}" FontSize="10"/>
                                <ComboBox Grid.Column="1" SelectedIndex="0">
                                    <ComboBoxItem Content="100%"/>
                                    <ComboBoxItem Content="110%"/>
                                </ComboBox>
                            </Grid>
                            <Grid><TextBlock Text="Show node preview thumbnails" Foreground="{StaticResource TextBrush}" FontSize="10"/><ToggleSwitch HorizontalAlignment="Right" IsOn="True" OnContent="On" OffContent="Off"/></Grid>
                            <Grid><TextBlock Text="Enhanced 3D previews" Foreground="{StaticResource TextBrush}" FontSize="10"/><ToggleSwitch HorizontalAlignment="Right" IsOn="True" OnContent="On" OffContent="Off"/></Grid>
                        </StackPanel>

                        <StackPanel x:Name="BehaviorSettingsColumn"
                                    Grid.Column="1"
                                    Spacing="7">
                            <TextBlock Text="Behavior" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold"/>
                            <Grid><TextBlock Text="Auto-save preferences" Foreground="{StaticResource TextBrush}" FontSize="10"/><ToggleSwitch HorizontalAlignment="Right" IsOn="True" OnContent="On" OffContent="Off"/></Grid>
                            <Grid><TextBlock Text="Confirm before delete" Foreground="{StaticResource TextBrush}" FontSize="10"/><ToggleSwitch HorizontalAlignment="Right" IsOn="True" OnContent="On" OffContent="Off"/></Grid>
                            <Grid><TextBlock Text="Play notification sounds" Foreground="{StaticResource TextBrush}" FontSize="10"/><ToggleSwitch HorizontalAlignment="Right" IsOn="True" OnContent="On" OffContent="Off"/></Grid>
                            <Grid><TextBlock Text="Minimize to system tray" Foreground="{StaticResource TextBrush}" FontSize="10"/><ToggleSwitch HorizontalAlignment="Right" IsOn="False" OnContent="On" OffContent="Off"/></Grid>
                            <Grid><TextBlock Text="Remember window layout" Foreground="{StaticResource TextBrush}" FontSize="10"/><ToggleSwitch HorizontalAlignment="Right" IsOn="True" OnContent="On" OffContent="Off"/></Grid>

                            <Border Height="1" Margin="0,4" Background="{StaticResource BorderBrush}"/>
                            <TextBlock Text="Project Handling" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="215"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Default project location" Foreground="{StaticResource TextBrush}" FontSize="10"/>
                                <TextBox Grid.Column="1" Text="D:\Projects\Workshop"/>
                            </Grid>
                            <Grid><TextBlock Text="Auto-create subfolders" Foreground="{StaticResource TextBrush}" FontSize="10"/><ToggleSwitch HorizontalAlignment="Right" IsOn="True" OnContent="On" OffContent="Off"/></Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Version history limit" Foreground="{StaticResource TextBrush}" FontSize="10"/>
                                <ComboBox Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="10"/></ComboBox>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Default export format" Foreground="{StaticResource TextBrush}" FontSize="10"/>
                                <ComboBox Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="FBX"/></ComboBox>
                            </Grid>
                            <Grid><TextBlock Text="Prompt for metadata" Foreground="{StaticResource TextBrush}" FontSize="10"/><ToggleSwitch HorizontalAlignment="Right" IsOn="True" OnContent="On" OffContent="Off"/></Grid>
                            <Button Content="↶   Reset to Defaults" HorizontalAlignment="Left" Padding="14,7"/>
                        </StackPanel>

                        <StackPanel x:Name="SettingsQuickActions"
                                    Grid.Column="2"
                                    Spacing="10">
                            <TextBlock Text="Quick Actions" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold"/>
                            <Button Content="□     Open Configuration Folder" HorizontalContentAlignment="Left" Padding="14,9"/>
                            <Button Content="↥     Export Settings" HorizontalContentAlignment="Left" Padding="14,9"/>
                            <Button Content="⇩     Import Settings" HorizontalContentAlignment="Left" Padding="14,9"/>
                            <Button Content="↻     Restore Default Settings" HorizontalContentAlignment="Left" Padding="14,9"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Storage management -->
            <Border x:Name="StorageManagementPanel"
                    Grid.Row="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3.4*"/>
                        <ColumnDefinition Width="1.05*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0"
                          Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="▱" Foreground="{StaticResource TextBrush}" FontSize="20"/>
                                <TextBlock Text="Storage Management" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Button Content="↻   Refresh" HorizontalAlignment="Right" Padding="12,5" FontSize="9"/>
                        </Grid>

                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    Spacing="0">
                            <Border Width="75" Background="#30231C" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,2">
                                <TextBlock Text="Drives" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontSize="9"/>
                            </Border>
                            <Border Width="105"><TextBlock Text="Cache &amp; Temp" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="9"/></Border>
                            <Border Width="85"><TextBlock Text="Libraries" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="9"/></Border>
                            <Border Width="85"><TextBlock Text="Cleanup" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="9"/></Border>
                            <Border Width="80"><TextBlock Text="Quotas" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="9"/></Border>
                        </StackPanel>

                        <Grid x:Name="StorageDriveTable"
                              Grid.Row="2"
                              Background="#161A1E">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="85"/>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Drive" Margin="8,4" Foreground="{StaticResource MutedBrush}" FontSize="8"/>
                            <TextBlock Grid.Column="1" Text="Label" Margin="4" Foreground="{StaticResource MutedBrush}" FontSize="8"/>
                            <TextBlock Grid.Column="2" Text="Type" Margin="4" Foreground="{StaticResource MutedBrush}" FontSize="8"/>
                            <TextBlock Grid.Column="3" Text="Total Space" Margin="4" Foreground="{StaticResource MutedBrush}" FontSize="8"/>
                            <TextBlock Grid.Column="4" Text="Used Space" Margin="4" Foreground="{StaticResource MutedBrush}" FontSize="8"/>
                            <TextBlock Grid.Column="5" Text="Free Space" Margin="4" Foreground="{StaticResource MutedBrush}" FontSize="8"/>
                            <TextBlock Grid.Column="6" Text="Usage" Margin="4" Foreground="{StaticResource MutedBrush}" FontSize="8"/>

                            <TextBlock Grid.Row="1" Text="C:" Margin="8,4" Foreground="{StaticResource TextBrush}" FontSize="9"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="System" Margin="4" Foreground="{StaticResource TextBrush}" FontSize="9"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="SSD" Margin="4" Foreground="{StaticResource TextBrush}" FontSize="9"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="1.00 TB" Margin="4" Foreground="{StaticResource TextBrush}" FontSize="9"/>
                            <TextBlock Grid.Row="1" Grid.Column="4" Text="823 GB" Margin="4" Foreground="{StaticResource TextBrush}" FontSize="9"/>
                            <TextBlock Grid.Row="1" Grid.Column="5" Text="177 GB" Margin="4" Foreground="{StaticResource TextBrush}" FontSize="9"/>
                            <Grid Grid.Row="1" Grid.Column="6" Margin="4,8" Background="#30363D"><Border Width="150" HorizontalAlignment="Left" Background="{StaticResource DangerBrush}"/></Grid>

                            <Border Grid.Row="2" Grid.ColumnSpan="7" Background="#5A3928" Opacity="0.78"/>
                            <TextBlock Grid.Row="2" Text="D:" Margin="8,4" Foreground="{StaticResource TextBrush}" FontSize="9"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Projects" Margin="4" Foreground="{StaticResource TextBrush}" FontSize="9"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="SSD" Margin="4" Foreground="{StaticResource TextBrush}" FontSize="9"/>
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="2.00 TB" Margin="4" Foreground="{StaticResource TextBrush}" FontSize="9"/>
                            <TextBlock Grid.Row="2" Grid.Column="4" Text="612 GB" Margin="4" Foreground="{StaticResource TextBrush}" FontSize="9"/>
                            <TextBlock Grid.Row="2" Grid.Column="5" Text="1.38 TB" Margin="4" Foreground="{StaticResource TextBrush}" FontSize="9"/>
                            <Grid Grid.Row="2" Grid.Column="6" Margin="4,8" Background="#30363D"><Border Width="58" HorizontalAlignment="Left" Background="{StaticResource BlueBrush}"/></Grid>

                            <TextBlock Grid.Row="3" Text="E:" Margin="8,4" Foreground="{StaticResource TextBrush}" FontSize="9"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Assets" Margin="4" Foreground="{StaticResource TextBrush}" FontSize="9"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="HDD" Margin="4" Foreground="{StaticResource TextBrush}" FontSize="9"/>
                            <TextBlock Grid.Row="3" Grid.Column="3" Text="4.00 TB" Margin="4" Foreground="{StaticResource TextBrush}" FontSize="9"/>
                            <TextBlock Grid.Row="3" Grid.Column="4" Text="1.21 TB" Margin="4" Foreground="{StaticResource TextBrush}" FontSize="9"/>
                            <TextBlock Grid.Row="3" Grid.Column="5" Text="2.79 TB" Margin="4" Foreground="{StaticResource TextBrush}" FontSize="9"/>
                            <Grid Grid.Row="3" Grid.Column="6" Margin="4,8" Background="#30363D"><Border Width="57" HorizontalAlignment="Left" Background="{StaticResource GoodBrush}"/></Grid>

                            <TextBlock Grid.Row="4" Text="F:" Margin="8,4" Foreground="{StaticResource TextBrush}" FontSize="9"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="Backups" Margin="4" Foreground="{StaticResource TextBrush}" FontSize="9"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="HDD" Margin="4" Foreground="{StaticResource TextBrush}" FontSize="9"/>
                            <TextBlock Grid.Row="4" Grid.Column="3" Text="4.00 TB" Margin="4" Foreground="{StaticResource TextBrush}" FontSize="9"/>
                            <TextBlock Grid.Row="4" Grid.Column="4" Text="58 GB" Margin="4" Foreground="{StaticResource TextBrush}" FontSize="9"/>
                            <TextBlock Grid.Row="4" Grid.Column="5" Text="3.94 TB" Margin="4" Foreground="{StaticResource TextBrush}" FontSize="9"/>
                            <Grid Grid.Row="4" Grid.Column="6" Margin="4,8" Background="#30363D"><Border Width="9" HorizontalAlignment="Left" Background="{StaticResource PurpleBrush}"/></Grid>
                        </Grid>
                    </Grid>

                    <StackPanel x:Name="StorageInsightsPanel"
                                Grid.Column="1"
                                Spacing="7">
                        <TextBlock Text="Storage Insights" Foreground="{StaticResource TextBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="14" Height="14" Background="{StaticResource GoodBrush}" CornerRadius="7"/>
                            <StackPanel Grid.Column="1" Spacing="-1"><TextBlock Text="Storage usage is healthy" Foreground="{StaticResource TextBrush}" FontSize="9"/><TextBlock Text="Plenty of free space available" Foreground="{StaticResource MutedBrush}" FontSize="8"/></StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="▲" Foreground="{StaticResource WarningBrush}" FontSize="14"/>
                            <StackPanel Grid.Column="1" Spacing="-1"><TextBlock Text="Large cache files detected" Foreground="{StaticResource AccentBrush}" FontSize="9"/><TextBlock Text="142 GB can be cleared" Foreground="{StaticResource MutedBrush}" FontSize="8"/></StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="14" Height="14" Background="{StaticResource GoodBrush}" CornerRadius="7"/>
                            <StackPanel Grid.Column="1" Spacing="-1"><TextBlock Text="Backup schedule is active" Foreground="{StaticResource TextBrush}" FontSize="9"/><TextBlock Text="Last backup: Nov 8, 2024 08:00" Foreground="{StaticResource MutedBrush}" FontSize="8"/></StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="14" Height="14" Background="{StaticResource BlueBrush}" CornerRadius="7"/>
                            <StackPanel Grid.Column="1" Spacing="-1"><TextBlock Text="Consider optimizing assets" Foreground="{StaticResource TextBrush}" FontSize="9"/><TextBlock Text="Potential 12% space saving" Foreground="{StaticResource MutedBrush}" FontSize="8"/></StackPanel>
                        </Grid>
                        <Button Content="↻   Run Cleanup" HorizontalAlignment="Stretch" Padding="12,5"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Storage inspector -->
        <Border x:Name="StorageLocationInspector"
                Grid.Column="2"
                Margin="0,8,8,0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,11">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="▰" Foreground="{StaticResource TextBrush}" FontSize="20"/>
                    <TextBlock Text="Storage Location Details" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Name" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                    <TextBox Grid.Column="1" Text="Projects (D:)"/>
                </Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Type" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Grid.Column="1" Text="Local Drive (SSD)" Foreground="{StaticResource TextBrush}" FontSize="10"/></Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Status" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Grid.Column="1" Text="●  Healthy" Foreground="{StaticResource GoodBrush}" FontSize="10"/></Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="File System" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Grid.Column="1" Text="NTFS" Foreground="{StaticResource TextBrush}" FontSize="10"/></Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Total Space" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Grid.Column="1" Text="2.00 TB" Foreground="{StaticResource TextBrush}" FontSize="10"/></Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Used Space" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Grid.Column="1" Text="612 GB (31%)" Foreground="{StaticResource TextBrush}" FontSize="10"/></Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Free Space" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Grid.Column="1" Text="1.38 TB" Foreground="{StaticResource TextBrush}" FontSize="10"/></Grid>
                <Grid Height="12" Background="#30363D"><Border Width="82" HorizontalAlignment="Left" Background="{StaticResource BlueBrush}"/></Grid>

                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,2"/>

                <TextBlock Text="Path" Foreground="{StaticResource TextBrush}" FontSize="11" FontWeight="SemiBold"/>
                <TextBox Text="D:\Projects\Workshop"/>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Content="□   Browse" Padding="12,7"/>
                    <Button Grid.Column="1" Content="↗   Open" Padding="12,7"/>
                </Grid>

                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,2"/>

                <TextBlock Text="Actions" Foreground="{StaticResource TextBrush}" FontSize="11" FontWeight="SemiBold"/>
                <Button Content="▱     Clear Project Cache" HorizontalContentAlignment="Left" Padding="14,9"/>
                <Button Content="◈     Verify Integrity" HorizontalContentAlignment="Left" Padding="14,9"/>
                <Button Content="⌕     Optimize Storage" HorizontalContentAlignment="Left" Padding="14,9"/>

                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,2"/>

                <TextBlock Text="More Options" Foreground="{StaticResource TextBrush}" FontSize="11" FontWeight="SemiBold"/>
                <Button Content="☆     Set as Default Location" HorizontalContentAlignment="Left" Padding="14,9"/>
                <Button Content="→     Move Existing Data" HorizontalContentAlignment="Left" Padding="14,9"/>
            </StackPanel>
        </Border>
    </Grid>

    <!-- Console / active tasks -->
    <Border x:Name="ActivityConsole"
            Grid.Row="2"
            Margin="8,8,8,0"
            Background="#14181C"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="0.95*"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="20" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock Text="Console" Foreground="{StaticResource AccentBrush}" FontSize="9"/>
                    <TextBlock Text="Jobs (2)" Foreground="{StaticResource MutedBrush}" FontSize="8"/>
                    <TextBlock Text="Warnings (1)" Foreground="{StaticResource MutedBrush}" FontSize="8"/>
                    <TextBlock Text="Info (12)" Foreground="{StaticResource MutedBrush}" FontSize="8"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="12,0,0,4" Spacing="1">
                    <TextBlock Text="[12:41:03]  Storage scan completed (4 drives, 1.24 TB used, 2.28 TB free)" Foreground="{StaticResource MutedBrush}" FontSize="7"/>
                    <TextBlock Text="[12:41:07]  Found 142 GB of cache files eligible for cleanup" Foreground="{StaticResource MutedBrush}" FontSize="7"/>
                    <TextBlock Text="[12:41:12]  Backup status: Last backup completed successfully (Nov 8, 2024 08:00)" Foreground="{StaticResource MutedBrush}" FontSize="7"/>
                    <TextBlock Text="[12:41:12]  Settings loaded from C:\Users\jla3d\AppData\Roaming\Workshop\config.json" Foreground="{StaticResource MutedBrush}" FontSize="7"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="ActiveTasksPanel"
                  Grid.Column="1"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1,0,0,0"
                  Padding="10,4">
                <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="Active Tasks" Foreground="{StaticResource TextBrush}" FontSize="9"/>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid><TextBlock Text="●  Indexing assets..." Foreground="{StaticResource MutedBrush}" FontSize="8"/><Grid Width="185" Height="6" HorizontalAlignment="Right" Background="#30363D"><Border Width="120" HorizontalAlignment="Left" Background="{StaticResource BlueBrush}"/></Grid><TextBlock Text="66%" HorizontalAlignment="Right" Margin="195,0,0,0" Foreground="{StaticResource MutedBrush}" FontSize="8"/></Grid>
                    <Grid Grid.Row="1"><TextBlock Text="●  Scanning cache..." Foreground="{StaticResource MutedBrush}" FontSize="8"/><Grid Width="185" Height="6" HorizontalAlignment="Right" Background="#30363D"><Border Width="45" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}"/></Grid><TextBlock Text="24%" HorizontalAlignment="Right" Margin="195,0,0,0" Foreground="{StaticResource MutedBrush}" FontSize="8"/></Grid>
                    <Grid Grid.Row="2"><TextBlock Text="●  Verifying backups..." Foreground="{StaticResource MutedBrush}" FontSize="8"/><Grid Width="185" Height="6" HorizontalAlignment="Right" Background="#30363D"><Border Width="22" HorizontalAlignment="Left" Background="{StaticResource PurpleBrush}"/></Grid><TextBlock Text="12%" HorizontalAlignment="Right" Margin="195,0,0,0" Foreground="{StaticResource MutedBrush}" FontSize="8"/></Grid>
                </Grid>
            </Grid>

            <Grid Grid.Column="2"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1,0,0,0"
                  Padding="10,4">
                <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="Estimated Time" Foreground="{StaticResource MutedBrush}" FontSize="8"/>
                <StackPanel Grid.Row="1" Spacing="1">
                    <TextBlock Text="2m 14s" Foreground="{StaticResource TextBrush}" FontSize="8"/>
                    <TextBlock Text="1m 03s" Foreground="{StaticResource TextBrush}" FontSize="8"/>
                    <TextBlock Text="4m 27s" Foreground="{StaticResource TextBrush}" FontSize="8"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>

    <!-- Shared workspace status footer -->
    <Border x:Name="WorkspaceStatusFooter"
            Grid.Row="3"
            Background="#101316"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="14,0">
        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Product identity -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="9"
                        VerticalAlignment="Center">
                <Border Width="26"
                        Height="26"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="2"
                        CornerRadius="4">
                    <TextBlock Text="◇"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="13"/>
                </Border>
                <StackPanel Spacing="-1">
                    <TextBlock Text="WORKSHOP"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               CharacterSpacing="90"/>
                    <TextBlock Text="Workspace status"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="9"/>
                </StackPanel>
            </StackPanel>

            <!-- Generic cross-workspace live status -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <Border x:Name="HostStatusChip"
                        Padding="10,5"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="7" Height="7" Background="{StaticResource GoodBrush}" CornerRadius="4"/>
                        <TextBlock Text="Host ready"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="10"/>
                    </StackPanel>
                </Border>

                <Border x:Name="QueueStatusChip"
                        Padding="10,5"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="7" Height="7" Background="{StaticResource GoodBrush}" CornerRadius="4"/>
                        <TextBlock Text="Queue healthy"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="10"/>
                    </StackPanel>
                </Border>

                <Border x:Name="ActiveTasksChip"
                        Padding="10,5"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="●"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="10"/>
                        <TextBlock Text="3 active tasks"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="10"/>
                    </StackPanel>
                </Border>

                <Border x:Name="StorageStatusChip"
                        Padding="10,5"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="▰"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10"/>
                        <TextBlock Text="Storage 31%"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="10"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Session / application state -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <Border Width="6" Height="6" Background="{StaticResource GoodBrush}" CornerRadius="3"/>
                    <TextBlock x:Name="SyncStatusText"
                               Text="Synced"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="9"/>
                </StackPanel>
                <TextBlock Text="Autosave on"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="9"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="VersionText"
                           Text="v2.0"
                           Foreground="#6C747D"
                           FontSize="9"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Grid>
