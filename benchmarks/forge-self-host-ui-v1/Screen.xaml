<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="ForgeWorkbenchConcept"
      Width="1672"
      Height="941"
      Background="#171B1D">
    <Grid.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#171B1D"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#22252A"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#1D2024"/>
        <SolidColorBrush x:Key="ElevatedBrush" Color="#2F3236"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#414448"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#F97419"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F2F3F5"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#AEB4BD"/>
    </Grid.Resources>

    <Grid.RowDefinitions>
        <RowDefinition Height="30"/>
        <RowDefinition Height="48"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="28"/>
    </Grid.RowDefinitions>

    <!-- Native-style application menu -->
    <Border x:Name="MenuRegion"
            Grid.Row="0"
            Background="#141719"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <MenuBar x:Name="MainMenu"
                     VerticalAlignment="Center">
                <MenuBarItem Title="File">
                    <MenuFlyoutItem Text="New UI"/>
                    <MenuFlyoutItem Text="Open XAML…"/>
                    <MenuFlyoutItem Text="Add Project Folder…"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Save"/>
                    <MenuFlyoutItem Text="Save As…"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Exit"/>
                </MenuBarItem>
                <MenuBarItem Title="Edit">
                    <MenuFlyoutItem Text="Undo"/>
                    <MenuFlyoutItem Text="Redo"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Delete"/>
                </MenuBarItem>
                <MenuBarItem Title="View">
                    <ToggleMenuFlyoutItem Text="Projects" IsChecked="True"/>
                    <ToggleMenuFlyoutItem Text="Source" IsChecked="True"/>
                    <ToggleMenuFlyoutItem Text="Inspector" IsChecked="True"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Fit Designer"/>
                    <MenuFlyoutItem Text="Actual Size"/>
                </MenuBarItem>
                <MenuBarItem Title="Project">
                    <MenuFlyoutItem Text="Add Folder…"/>
                    <MenuFlyoutItem Text="Refresh"/>
                    <MenuFlyoutItem Text="Open in Explorer"/>
                </MenuBarItem>
                <MenuBarItem Title="Designer">
                    <MenuFlyoutItem Text="Render Now"/>
                    <MenuFlyoutItem Text="Load Reference…"/>
                    <MenuFlyoutItem Text="Export Review Package…"/>
                </MenuBarItem>
                <MenuBarItem Title="Help">
                    <MenuFlyoutItem Text="Forge Documentation"/>
                    <MenuFlyoutItem Text="About WinUI Forge"/>
                </MenuBarItem>
            </MenuBar>

            <TextBlock Grid.Column="2"
                       Text="WinUI Forge"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center"
                       Margin="12,0"/>
        </Grid>
    </Border>

    <!-- Main command toolbar -->
    <Border x:Name="ToolbarRegion"
            Grid.Row="1"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
        <CommandBar x:Name="MainCommandBar"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    IsOpen="False">
            <AppBarButton Label="New">
                <AppBarButton.Icon><FontIcon Glyph="&#xE710;"/></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Open">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8E5;"/></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Save">
                <AppBarButton.Icon><FontIcon Glyph="&#xE74E;"/></AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator/>
            <AppBarButton Label="Undo">
                <AppBarButton.Icon><FontIcon Glyph="&#xE7A7;"/></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Redo">
                <AppBarButton.Icon><FontIcon Glyph="&#xE7A6;"/></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Delete">
                <AppBarButton.Icon><FontIcon Glyph="&#xE74D;"/></AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator/>
            <AppBarButton Label="Reference">
                <AppBarButton.Icon><FontIcon Glyph="&#xEB9F;"/></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Review">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8A5;"/></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Render">
                <AppBarButton.Icon><FontIcon Glyph="&#xE768;"/></AppBarButton.Icon>
            </AppBarButton>
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="Reset Workspace"/>
                <AppBarButton Label="Preferences"/>
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Border>

    <!-- Development-tool workspace -->
    <Grid x:Name="Workbench"
          Grid.Row="2"
          Background="{StaticResource BorderBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48"/>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="410"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>

        <!-- Activity rail -->
        <Border x:Name="ActivityRail"
                Grid.Column="0"
                Background="#171A1D"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <StackPanel Spacing="4"
                        Margin="5,8">
                <Button ToolTipService.ToolTip="Projects"
                        Width="38"
                        Height="38"
                        Background="#2D3034">
                    <FontIcon Glyph="&#xE8B7;"
                              Foreground="{StaticResource AccentBrush}"/>
                </Button>
                <Button ToolTipService.ToolTip="Source"
                        Width="38"
                        Height="38"
                        Background="Transparent">
                    <FontIcon Glyph="&#xE943;"
                              Foreground="{StaticResource TextBrush}"/>
                </Button>
                <Button ToolTipService.ToolTip="Search"
                        Width="38"
                        Height="38"
                        Background="Transparent">
                    <FontIcon Glyph="&#xE721;"
                              Foreground="{StaticResource TextBrush}"/>
                </Button>
                <Button ToolTipService.ToolTip="Designer"
                        Width="38"
                        Height="38"
                        Background="Transparent">
                    <FontIcon Glyph="&#xE790;"
                              Foreground="{StaticResource TextBrush}"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- Projects -->
        <Grid x:Name="ProjectsPanel"
              Grid.Column="1"
              Background="{StaticResource PanelAltBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="8,0">
                <Grid>
                    <TextBlock Text="PROJECTS"
                               Foreground="{StaticResource MutedBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="2">
                        <Button Width="28" Height="28" ToolTipService.ToolTip="Add folder">
                            <FontIcon Glyph="&#xE8F4;"/>
                        </Button>
                        <Button Width="28" Height="28" ToolTipService.ToolTip="Refresh">
                            <FontIcon Glyph="&#xE72C;"/>
                        </Button>
                        <Button Width="28" Height="28" ToolTipService.ToolTip="More">
                            <FontIcon Glyph="&#xE712;"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1"
                        Padding="8,8"
                        Spacing="3">
                <TextBlock Text="▼ WORKSHOP UI"
                           Foreground="{StaticResource TextBrush}"
                           FontWeight="SemiBold"/>
                <TextBlock Text="  ▼ Dashboard"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="      ◇ Screen.xaml"
                           Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="      ▣ W2-01-dashboard.png"
                           Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="      · Screen.forge.json"
                           Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="  ▼ Storage &amp; Settings"
                           Foreground="{StaticResource TextBrush}"
                           Margin="0,6,0,0"/>
                <TextBlock Text="      ◇ Screen.xaml"
                           Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="      ▣ W2-14-storage-settings.png"
                           Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="  ▶ Forge Self UI"
                           Foreground="{StaticResource TextBrush}"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <Border Grid.Row="2"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="8,0">
                <TextBlock Text="3 screens · 2 references"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <Border Grid.Column="2" Background="#51555A"/>

        <!-- Source editor -->
        <Grid x:Name="SourcePanel"
              Grid.Column="3"
              Background="#1B1E21">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="8,0">
                <Grid>
                    <TextBlock Text="Screen.xaml"
                               Foreground="{StaticResource TextBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="2">
                        <Button Width="28" Height="28" ToolTipService.ToolTip="Reload">
                            <FontIcon Glyph="&#xE72C;"/>
                        </Button>
                        <Button Width="28" Height="28" ToolTipService.ToolTip="Save">
                            <FontIcon Glyph="&#xE74E;"/>
                        </Button>
                        <Button Width="28" Height="28" ToolTipService.ToolTip="Source options">
                            <FontIcon Glyph="&#xE712;"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="0"
                    Padding="12"
                    Background="#171A1D">
                <TextBlock FontFamily="Consolas"
                           FontSize="13"
                           Foreground="#C8D0D8"
                           TextWrapping="NoWrap"
                           Text="&lt;Grid x:Name=&quot;Dashboard&quot;&#x0A;      Background=&quot;#171B1D&quot;&gt;&#x0A;    &lt;Grid.RowDefinitions&gt;&#x0A;        &lt;RowDefinition Height=&quot;60&quot;/&gt;&#x0A;        &lt;RowDefinition Height=&quot;*&quot;/&gt;&#x0A;    &lt;/Grid.RowDefinitions&gt;&#x0A;&#x0A;    &lt;Border x:Name=&quot;TopCommandBar&quot; ... /&gt;&#x0A;    &lt;Grid x:Name=&quot;Workspace&quot; Grid.Row=&quot;1&quot;&gt;&#x0A;        ...&#x0A;    &lt;/Grid&gt;&#x0A;&lt;/Grid&gt;"/>
            </Border>

            <Border Grid.Row="2"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="8,0">
                <TextBlock Text="Ln 42, Col 18 · UTF-8 · XAML"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <Border Grid.Column="4" Background="#51555A"/>

        <!-- Designer -->
        <Grid x:Name="DesignerPanel"
              Grid.Column="5"
              Background="{StaticResource WindowBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="8,0">
                <Grid>
                    <TextBlock Text="DESIGNER"
                               Foreground="{StaticResource MutedBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="2">
                        <Button Width="28" Height="28" ToolTipService.ToolTip="Fit">
                            <FontIcon Glyph="&#xE9A6;"/>
                        </Button>
                        <Button Width="28" Height="28" ToolTipService.ToolTip="Actual size">
                            <FontIcon Glyph="&#xE8A3;"/>
                        </Button>
                        <Button Width="28" Height="28" ToolTipService.ToolTip="Toggle reference">
                            <FontIcon Glyph="&#xE7B3;"/>
                        </Button>
                        <Button Width="28" Height="28" ToolTipService.ToolTip="Designer options">
                            <FontIcon Glyph="&#xE712;"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="#1D2024"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="8,0">
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <TextBlock Text="1672 × 941"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"/>
                    <Button Content="Fit"/>
                    <Button Content="Overlay"/>
                    <Slider Width="100" Value="50"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Margin="16"
                    Background="#2F3236"
                    BorderBrush="#51555A"
                    BorderThickness="1">
                <Grid Margin="24"
                      Background="#171B1D">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="48"/>
                    </Grid.RowDefinitions>
                    <Border Background="#23272B"
                            BorderBrush="#414448"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="WORKSHOP UI PREVIEW"
                                   Foreground="#F2F3F5"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="16,0"/>
                    </Border>
                    <Grid Grid.Row="1" Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="0.8*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center"
                                    Spacing="10">
                            <TextBlock Text="Live WinUI canvas"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       Foreground="#F2F3F5"/>
                            <TextBlock Text="Canvas edits update XAML immediately."
                                       Foreground="#AEB4BD"/>
                            <Button Content="Selected element"
                                    HorizontalAlignment="Left"
                                    Background="#F97419"/>
                        </StackPanel>
                        <Border Grid.Column="1"
                                Margin="24"
                                BorderBrush="#F97419"
                                BorderThickness="1"
                                CornerRadius="6"/>
                    </Grid>
                    <Border Grid.Row="2"
                            Background="#202327"
                            BorderBrush="#414448"
                            BorderThickness="0,1,0,0"/>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="8,0">
                <TextBlock Text="Ready · reference paired · viewport 1672 × 941"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <Border Grid.Column="6" Background="#51555A"/>

        <!-- Inspector / toolbox / tree -->
        <Grid x:Name="InspectorPanel"
              Grid.Column="7"
              Background="{StaticResource PanelAltBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                Spacing="14"
                                Margin="10,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="TOOLBOX"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="VISUAL TREE"
                                   Foreground="{StaticResource TextBrush}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="INSPECTOR"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                    <Button Width="28"
                            Height="28"
                            HorizontalAlignment="Right"
                            Margin="0,0,4,0"
                            ToolTipService.ToolTip="Panel options">
                        <FontIcon Glyph="&#xE712;"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="160"/>
                </Grid.RowDefinitions>
                <TextBox Margin="8,6"
                         PlaceholderText="Filter Visual Tree…"/>
                <StackPanel Grid.Row="1"
                            Padding="10,6"
                            Spacing="8">
                    <TextBlock Text="Dashboard [Grid]"
                               Foreground="{StaticResource TextBrush}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="  TopCommandBar [Border]"
                               Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="  Workspace [Grid]"
                               Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="    ContentArea [Grid]"
                               Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="      HeadingText [TextBlock]"
                               Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="      QuickActions [Grid]"
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="    Inspector [Border]"
                               Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
                <Border Grid.Row="2"
                        Background="#202327"
                        BorderBrush="#414448"
                        BorderThickness="0,1,0,0"
                        Padding="10">
                    <StackPanel Spacing="6">
                        <TextBlock Text="SELECTION"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="QuickActions · Grid"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Row 1 · Column 0 · Stretch"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="Up"/>
                            <Button Content="Down"/>
                            <Button Content="Reparent"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>

    <!-- Global status bar -->
    <Border x:Name="StatusBar"
            Grid.Row="3"
            Background="#141719"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="8,0">
        <Grid>
            <StackPanel Orientation="Horizontal"
                        Spacing="14"
                        VerticalAlignment="Center">
                <TextBlock Text="● Ready"
                           Foreground="#67D86B"/>
                <TextBlock Text="Screen.xaml"
                           Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="No errors"
                           Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="14"
                        VerticalAlignment="Center">
                <TextBlock Text="Fit"
                           Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="1672 × 941"
                           Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="WinUI 3"
                           Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
        </Grid>
    </Border>
</Grid>
