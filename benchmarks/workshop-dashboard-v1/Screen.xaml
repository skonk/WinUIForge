<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="WorkshopDashboardBenchmark"
      Background="#15181B">
    <Grid.Resources>
        <SolidColorBrush x:Key="ShellBrush" Color="#15181B"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#1B1F23"/>
        <SolidColorBrush x:Key="CardBrush" Color="#20252A"/>
        <SolidColorBrush x:Key="ElevatedBrush" Color="#252B31"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#343B43"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#F97316"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F4F6F8"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9DA6B2"/>
        <SolidColorBrush x:Key="GoodBrush" Color="#63C58A"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#E7B05E"/>
    </Grid.Resources>

    <Grid.RowDefinitions>
        <RowDefinition Height="54"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="132"/>
    </Grid.RowDefinitions>

    <!-- Shared Workshop shell / top command bar -->
    <Border x:Name="TopCommandBar"
            Grid.Row="0"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
        <Grid Padding="14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="205"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="259"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                <Border Width="22"
                        Height="22"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="4"/>
                <StackPanel Spacing="0">
                    <TextBlock Text="WORKSHOP"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="2.0"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="10"/>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Column="1"
                  ColumnSpacing="10"
                  VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Dashboard"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <Border Grid.Column="1"
                        MaxWidth="560"
                        Height="34"
                        HorizontalAlignment="Center"
                        Background="{StaticResource ElevatedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⌕"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="16"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Margin="8,0,0,0"
                                   Text="Search projects, assets and commands..."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Text="Ctrl+K"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button Content="New project"
                            Padding="14,6"
                            Background="{StaticResource AccentBrush}"
                            Foreground="#16191C"/>
                    <Button Content="⋯"
                            Width="34"
                            Height="34"
                            Padding="0"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Spacing="9">
                <Border Padding="9,5"
                        Background="{StaticResource ElevatedBrush}"
                        CornerRadius="5">
                    <TextBlock Text="Beacon"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="11"/>
                </Border>
                <Border Width="30"
                        Height="30"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="15">
                    <TextBlock Text="J"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#16191C"
                               FontWeight="Bold"/>
                </Border>
            </StackPanel>
        </Grid>
    </Border>

    <!-- Dashboard work area -->
    <Grid x:Name="DashboardWorkspace"
          Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="205"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="259"/>
        </Grid.ColumnDefinitions>

        <!-- Local dashboard pane; not a second global app navigation -->
        <Border x:Name="LocalDashboardPane"
                Grid.Column="0"
                Background="#181B1F"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="14,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Spacing="8">
                    <TextBlock Text="OVERVIEW"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                    <Border Padding="10,8"
                            Background="#2A241F"
                            BorderBrush="#6B3A1B"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource AccentBrush}"
                                    CornerRadius="2"/>
                            <TextBlock Grid.Column="1"
                                       Margin="9,0,0,0"
                                       Text="Today"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                        </Grid>
                    </Border>
                    <Button Content="Active work"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Foreground="{StaticResource MutedBrush}"/>
                    <Button Content="Recent"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Foreground="{StaticResource MutedBrush}"/>
                    <Button Content="Pinned"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Foreground="{StaticResource MutedBrush}"/>

                    <Border Height="1"
                            Margin="0,8"
                            Background="{StaticResource BorderBrush}"/>

                    <TextBlock Text="FOCUS"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                    <CheckBox Content="Projects"
                              IsChecked="True"
                              Foreground="{StaticResource TextBrush}"/>
                    <CheckBox Content="Assets"
                              IsChecked="True"
                              Foreground="{StaticResource TextBrush}"/>
                    <CheckBox Content="Jobs"
                              IsChecked="True"
                              Foreground="{StaticResource TextBrush}"/>
                    <CheckBox Content="Workers"
                              IsChecked="True"
                              Foreground="{StaticResource TextBrush}"/>
                </StackPanel>

                <StackPanel Grid.Row="2"
                            Spacing="8">
                    <Border Padding="10"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Workspace"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="10"/>
                            <TextBlock Text="Groundforge"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Local · Healthy"
                                       Foreground="{StaticResource GoodBrush}"
                                       FontSize="10"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Workshop 2.0"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="9"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Flexible central dashboard -->
        <Grid x:Name="DashboardMain"
              Grid.Column="1"
              Background="{StaticResource ShellBrush}"
              Padding="18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="92"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock x:Name="DashboardHeading"
                               Text="Production dashboard"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="22"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Overview of active projects, workers and recent activity"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Border Padding="9,5"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <TextBlock Text="Last 24 hours"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10"/>
                    </Border>
                    <Button Content="Refresh"
                            Padding="11,5"/>
                </StackPanel>
            </Grid>

            <!-- Four KPI cards -->
            <Grid x:Name="MetricCards"
                  Grid.Row="1"
                  Margin="0,12,0,0"
                  ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="ActiveProjectsMetric"
                        Grid.Column="0"
                        Padding="12,10"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="ACTIVE PROJECTS"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1"
                                   Text="12"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    Spacing="5">
                            <TextBlock Text="+2"
                                       Foreground="{StaticResource GoodBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="this week"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="10"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="QueuedJobsMetric"
                        Grid.Column="1"
                        Padding="12,10"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="QUEUED JOBS"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1"
                                   Text="28"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2"
                                   Text="6 running now"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="10"/>
                    </Grid>
                </Border>

                <Border x:Name="WorkersMetric"
                        Grid.Column="2"
                        Padding="12,10"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="WORKERS ONLINE"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1"
                                   Text="6 / 8"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2"
                                   Text="2 idle"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10"/>
                    </Grid>
                </Border>

                <Border x:Name="StorageMetric"
                        Grid.Column="3"
                        Padding="12,10"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="STORAGE"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1"
                                   Text="68%"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Grid Grid.Row="2"
                              Height="5"
                              Background="#30363D">
                            <Border Width="112"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource AccentBrush}"
                                    CornerRadius="3"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Main dashboard content -->
            <Grid Grid.Row="2"
                  Margin="0,12,0,0"
                  ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0"
                      RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="RecentActivityPanel"
                            Padding="14"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Recent Activity"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="14"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Latest changes across this workspace"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="10"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="View all"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="10"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Grid.Row="1"
                                  Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Width="7"
                                        Height="7"
                                        Background="{StaticResource AccentBrush}"
                                        CornerRadius="4"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1"
                                            Spacing="2"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Groundforge Bases · export completed"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="11"/>
                                    <TextBlock Text="42 files written to the release package"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="9"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="2m"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="9"
                                           VerticalAlignment="Center"/>

                                <Border Grid.Row="1"
                                        Width="7"
                                        Height="7"
                                        Background="{StaticResource GoodBrush}"
                                        CornerRadius="4"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="1"
                                            Grid.Column="1"
                                            Spacing="2"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Mesh validation passed"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="11"/>
                                    <TextBlock Text="Workshop worker 03 · 18 assets checked"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="9"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1"
                                           Grid.Column="2"
                                           Text="11m"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="9"
                                           VerticalAlignment="Center"/>

                                <Border Grid.Row="2"
                                        Width="7"
                                        Height="7"
                                        Background="{StaticResource WarningBrush}"
                                        CornerRadius="4"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="2"
                                            Grid.Column="1"
                                            Spacing="2"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="2 review items need attention"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="11"/>
                                    <TextBlock Text="Terrain Concepts · visual review queue"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="9"/>
                                </StackPanel>
                                <TextBlock Grid.Row="2"
                                           Grid.Column="2"
                                           Text="34m"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="9"
                                           VerticalAlignment="Center"/>

                                <Border Grid.Row="3"
                                        Width="7"
                                        Height="7"
                                        Background="#65707C"
                                        CornerRadius="4"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="3"
                                            Grid.Column="1"
                                            Spacing="2"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Project snapshot saved"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="11"/>
                                    <TextBlock Text="WinUI Forge · benchmark workspace"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="9"/>
                                </StackPanel>
                                <TextBlock Grid.Row="3"
                                           Grid.Column="2"
                                           Text="1h"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="9"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border x:Name="RecentProjectsPanel"
                            Grid.Row="1"
                            Padding="14"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Recent Projects"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                            <Grid Grid.Row="1"
                                  Margin="0,10,0,0"
                                  ColumnSpacing="9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Padding="10"
                                        Background="{StaticResource ElevatedBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel Spacing="6">
                                        <Border Height="5"
                                                Width="34"
                                                HorizontalAlignment="Left"
                                                Background="{StaticResource AccentBrush}"
                                                CornerRadius="3"/>
                                        <TextBlock Text="Groundforge Bases"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="3D asset pipeline"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="9"/>
                                        <TextBlock Text="Updated 2m ago"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="9"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        Padding="10"
                                        Background="{StaticResource ElevatedBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel Spacing="6">
                                        <Border Height="5"
                                                Width="34"
                                                HorizontalAlignment="Left"
                                                Background="#64748B"
                                                CornerRadius="3"/>
                                        <TextBlock Text="Terrain Concepts"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Concept workflow"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="9"/>
                                        <TextBlock Text="Updated 34m ago"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="9"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Padding="10"
                                        Background="{StaticResource ElevatedBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel Spacing="6">
                                        <Border Height="5"
                                                Width="34"
                                                HorizontalAlignment="Left"
                                                Background="#547A65"
                                                CornerRadius="3"/>
                                        <TextBlock Text="Workshop 2"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Desktop application"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="9"/>
                                        <TextBlock Text="Updated 1h ago"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="9"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Column="1"
                      RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="230"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="QuickActionsPanel"
                            Padding="14"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Quick Actions"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Common production tasks"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="10"/>
                            </StackPanel>
                            <Grid Grid.Row="1"
                                  Margin="0,11,0,0"
                                  ColumnSpacing="8"
                                  RowSpacing="8"
                                  VerticalAlignment="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="76"/>
                                    <RowDefinition Height="76"/>
                                </Grid.RowDefinitions>

                                <Button x:Name="QuickActionNewProject"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        HorizontalContentAlignment="Left"
                                        VerticalContentAlignment="Stretch"
                                        Padding="11"
                                        Background="{StaticResource ElevatedBrush}">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="+"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="17"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="New project"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontSize="10"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Row="0"
                                        Grid.Column="1"
                                        HorizontalContentAlignment="Left"
                                        VerticalContentAlignment="Stretch"
                                        Padding="11"
                                        Background="{StaticResource ElevatedBrush}">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="↥"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="17"/>
                                        <TextBlock Text="Import assets"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontSize="10"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Row="1"
                                        Grid.Column="0"
                                        HorizontalContentAlignment="Left"
                                        VerticalContentAlignment="Stretch"
                                        Padding="11"
                                        Background="{StaticResource ElevatedBrush}">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="▶"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="14"/>
                                        <TextBlock Text="Run workflow"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontSize="10"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Row="1"
                                        Grid.Column="1"
                                        HorizontalContentAlignment="Left"
                                        VerticalContentAlignment="Stretch"
                                        Padding="11"
                                        Background="{StaticResource ElevatedBrush}">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="✓"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="15"/>
                                        <TextBlock Text="Review queue"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontSize="10"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border x:Name="WorkerStatusPanel"
                            Grid.Row="1"
                            Padding="14"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Worker Status"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1"
                                           Text="6 online"
                                           Foreground="{StaticResource GoodBrush}"
                                           FontSize="10"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel Grid.Row="1"
                                        Margin="0,10,0,0"
                                        Spacing="8">
                                <Border Padding="9"
                                        Background="{StaticResource ElevatedBrush}"
                                        CornerRadius="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="7"
                                                Height="7"
                                                Background="{StaticResource GoodBrush}"
                                                CornerRadius="4"
                                                VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1"
                                                    Margin="8,0"
                                                    Spacing="1">
                                            <TextBlock Text="Worker 01"
                                                       Foreground="{StaticResource TextBrush}"
                                                       FontSize="10"/>
                                            <TextBlock Text="Generating previews"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="9"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="72%"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border Padding="9"
                                        Background="{StaticResource ElevatedBrush}"
                                        CornerRadius="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="7"
                                                Height="7"
                                                Background="{StaticResource GoodBrush}"
                                                CornerRadius="4"
                                                VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1"
                                                    Margin="8,0"
                                                    Spacing="1">
                                            <TextBlock Text="Worker 03"
                                                       Foreground="{StaticResource TextBrush}"
                                                       FontSize="10"/>
                                            <TextBlock Text="Mesh validation"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="9"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="44%"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border Padding="9"
                                        Background="{StaticResource ElevatedBrush}"
                                        CornerRadius="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="7"
                                                Height="7"
                                                Background="#65707C"
                                                CornerRadius="4"
                                                VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1"
                                                    Margin="8,0"
                                                    Spacing="1">
                                            <TextBlock Text="Worker 06"
                                                       Foreground="{StaticResource TextBrush}"
                                                       FontSize="10"/>
                                            <TextBlock Text="Idle · ready"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="9"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="Idle"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Right inspector -->
        <Border x:Name="ProjectInspector"
                Grid.Column="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0"
                Padding="15,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Project Inspector"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Selected project"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="⋯"
                            Width="30"
                            Height="30"
                            Padding="0"/>
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,14,0,0"
                        Padding="12"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <Border Width="9"
                                    Height="9"
                                    Background="{StaticResource AccentBrush}"
                                    CornerRadius="5"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="Groundforge Bases"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="3D asset pipeline"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10"/>
                        <Border HorizontalAlignment="Left"
                                Padding="7,3"
                                Background="#1F3328"
                                CornerRadius="4">
                            <TextBlock Text="ACTIVE"
                                       Foreground="{StaticResource GoodBrush}"
                                       FontSize="9"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2"
                            Margin="0,16,0,0"
                            Spacing="12">
                    <StackPanel Spacing="5">
                        <TextBlock Text="PROGRESS"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>
                        <Grid Height="6"
                              Background="#30363D">
                            <Border Width="154"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource AccentBrush}"
                                    CornerRadius="3"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="18 of 24 tasks"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="10"/>
                            <TextBlock Text="75%"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"/>
                        </Grid>
                    </StackPanel>

                    <Border Height="1"
                            Background="{StaticResource BorderBrush}"/>

                    <StackPanel Spacing="8">
                        <TextBlock Text="DETAILS"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>
                        <Grid>
                            <TextBlock Text="Owner"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="10"/>
                            <TextBlock Text="James"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="10"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="Workers"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="10"/>
                            <TextBlock Text="3"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="10"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="Queued"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="10"/>
                            <TextBlock Text="8 jobs"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="10"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="Updated"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="10"/>
                            <TextBlock Text="2 minutes ago"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="10"/>
                        </Grid>
                    </StackPanel>

                    <Border Height="1"
                            Background="{StaticResource BorderBrush}"/>

                    <StackPanel Spacing="7">
                        <TextBlock Text="NEXT TASK"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Review generated preview set"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Waiting for visual approval before packaging."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="9"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Row="3"
                        Content="Open project"
                        HorizontalAlignment="Stretch"
                        Padding="12,7"
                        Background="{StaticResource AccentBrush}"
                        Foreground="#16191C"/>
            </Grid>
        </Border>
    </Grid>

    <!-- Bottom activity/resource console -->
    <Border x:Name="ActivityConsole"
            Grid.Row="2"
