<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="WorkshopDashboardBenchmark"
      Background="#121518">
    <Grid.Resources>
        <SolidColorBrush x:Key="ShellBrush" Color="#121518"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#171B1F"/>
        <SolidColorBrush x:Key="CardBrush" Color="#1D2227"/>
        <SolidColorBrush x:Key="ElevatedBrush" Color="#23292F"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#30373F"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#F97316"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F2F4F6"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#98A1AC"/>
        <SolidColorBrush x:Key="GoodBrush" Color="#48C785"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#E2A84F"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#D85A5A"/>
    </Grid.Resources>

    <Grid.RowDefinitions>
        <RowDefinition Height="144"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="110"/>
        <RowDefinition Height="68"/>
    </Grid.RowDefinitions>

    <!-- Shared Workshop shell -->
    <Border x:Name="TopCommandBar"
            Grid.Row="0"
            Background="#14181C"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="84"/>
            </Grid.RowDefinitions>

            <!-- Global application row -->
            <Grid Grid.Row="0"
                  Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                    <Border Width="34"
                            Height="34"
                            Background="{StaticResource AccentBrush}"
                            CornerRadius="5">
                        <TextBlock Text="◇"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#17191B"
                                   FontSize="18"
                                   FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="Workshop"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="23"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Border Width="1"
                            Height="34"
                            Margin="4,0"
                            Background="{StaticResource BorderBrush}"/>
                    <StackPanel VerticalAlignment="Center"
                                Spacing="-1">
                        <TextBlock Text="Dashboard"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="17"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Overview and task control"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Stretch"
                            Spacing="8">
                    <Grid Width="92">
                        <Image Source="ms-appx:///Assets/WorkshopUi/Navigation/Dashboard.png"
                               Width="22"
                               Height="22"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,5,0,0"
                               Stretch="Uniform"/>
                        <TextBlock Text="Dashboard"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,8"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="13"/>
                        <Border Height="2"
                                VerticalAlignment="Bottom"
                                Background="{StaticResource AccentBrush}"/>
                    </Grid>
                    <Grid Width="92">
                        <Image Source="ms-appx:///Assets/WorkshopUi/Navigation/Prepare.png"
                               Width="22"
                               Height="22"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,5,0,0"
                               Opacity="0.72"
                               Stretch="Uniform"/>
                        <TextBlock Text="Prepare"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,8"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="13"/>
                    </Grid>
                    <Grid Width="92">
                        <Image Source="ms-appx:///Assets/WorkshopUi/Navigation/Conduit.png"
                               Width="22"
                               Height="22"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,5,0,0"
                               Opacity="0.72"
                               Stretch="Uniform"/>
                        <TextBlock Text="Conduit"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,8"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="13"/>
                    </Grid>
                    <Grid Width="92">
                        <Image Source="ms-appx:///Assets/WorkshopUi/Navigation/Library.png"
                               Width="22"
                               Height="22"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,5,0,0"
                               Opacity="0.72"
                               Stretch="Uniform"/>
                        <TextBlock Text="Library"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,8"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="13"/>
                    </Grid>
                    <Grid Width="92">
                        <Image Source="ms-appx:///Assets/WorkshopUi/Navigation/Settings.png"
                               Width="22"
                               Height="22"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,5,0,0"
                               Opacity="0.72"
                               Stretch="Uniform"/>
                        <TextBlock Text="Settings"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,8"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="13"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Spacing="18">
                    <TextBlock Text="—"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="18"/>
                    <TextBlock Text="▢"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="16"/>
                    <TextBlock Text="×"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="20"/>
                </StackPanel>
            </Grid>

            <!-- Context command surface -->
            <Border Grid.Row="1"
                    Margin="8,0,8,0"
                    Background="#171B1F"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="48"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Spacing="26"
                                Margin="16,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="File" Foreground="{StaticResource TextBrush}" FontSize="13"/>
                        <TextBlock Text="Edit" Foreground="{StaticResource TextBrush}" FontSize="13"/>
                        <TextBlock Text="View" Foreground="{StaticResource TextBrush}" FontSize="13"/>
                        <TextBlock Text="Tools" Foreground="{StaticResource TextBrush}" FontSize="13"/>
                        <TextBlock Text="Help" Foreground="{StaticResource TextBrush}" FontSize="13"/>
                    </StackPanel>

                    <Grid Grid.Row="1"
                          Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Content="□  New" Padding="11,6" FontSize="12"/>
                            <Button Content="□  Open" Padding="11,6" FontSize="12"/>
                            <Button Content="↓  Import" Padding="11,6" FontSize="12"/>
                            <Border Width="1" Height="25" Margin="4,0" Background="{StaticResource BorderBrush}"/>
                            <Button Content="＋  Add Job" Padding="11,6" FontSize="12"/>
                            <Border Width="1" Height="25" Margin="4,0" Background="{StaticResource BorderBrush}"/>
                            <Button Content="Ⅱ  Pause All" Padding="11,6" FontSize="12"/>
                            <Button Content="▷  Resume All" Padding="11,6" FontSize="12"/>
                            <Button Content="×  Cancel" Padding="11,6" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Border Padding="12,7"
                                    Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <TextBlock Text="⬡  All Workers   ⌄"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="12"/>
                            </Border>
                            <Border Padding="12,7"
                                    Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <TextBlock Text="▣  Last 7 Days   ⌄"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="12"/>
                            </Border>
                            <Button Content="↻  Refresh" Padding="12,7" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>

    <Grid x:Name="DashboardWorkspace"
          Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <!-- Main navigation / tool pane -->
        <Border x:Name="LocalDashboardPane"
                Grid.Column="0"
                Background="#15191D"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="96"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="10,9"
                            Spacing="4">
                    <TextBlock Text="OVERVIEW"
                               Margin="4,0,0,3"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"/>

                    <Border Padding="9,8"
                            Background="#30231D"
                            BorderBrush="#5F341E"
                            BorderThickness="1"
                            CornerRadius="4">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <TextBlock Text="⌂"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="15"/>
                            <TextBlock Text="Recent Overview"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <Button Content="▦   Recent Jobs"
                            HorizontalContentAlignment="Left"
                            Padding="9,7"
                            Background="Transparent"
                            Foreground="{StaticResource MutedBrush}"
                            FontSize="13"/>
                    <Button Content="□   Projects"
                            HorizontalContentAlignment="Left"
                            Padding="9,7"
                            Background="Transparent"
                            Foreground="{StaticResource MutedBrush}"
                            FontSize="13"/>
                    <Button Content="◇   Assets"
                            HorizontalContentAlignment="Left"
                            Padding="9,7"
                            Background="Transparent"
                            Foreground="{StaticResource MutedBrush}"
                            FontSize="13"/>
                    <Button Content="▤   Reports"
                            HorizontalContentAlignment="Left"
                            Padding="9,7"
                            Background="Transparent"
                            Foreground="{StaticResource MutedBrush}"
                            FontSize="13"/>
                    <Button Content="⌁   Analytics"
                            HorizontalContentAlignment="Left"
                            Padding="9,7"
                            Background="Transparent"
                            Foreground="{StaticResource MutedBrush}"
                            FontSize="13"/>

                    <Border Height="1"
                            Margin="0,8"
                            Background="{StaticResource BorderBrush}"/>

                    <Button Content="⚙   Settings"
                            HorizontalContentAlignment="Left"
                            Padding="9,7"
                            Background="Transparent"
                            Foreground="{StaticResource MutedBrush}"
                            FontSize="13"/>
                </StackPanel>

                <Border Grid.Row="1"
                        Margin="10,0,10,10"
                        Padding="10"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="7">
                            <TextBlock Text="▱"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="14"/>
                            <TextBlock Text="Storage"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="13"/>
                        </StackPanel>
                        <Grid Height="5"
                              Background="#30363D">
                            <Border Width="52"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource AccentBrush}"
                                    CornerRadius="3"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="Groundforge"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="12"/>
                            <TextBlock Text="4.0 TB   30%"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"/>
                        </Grid>
                        <TextBlock Text="Local · Healthy"
                                   Foreground="{StaticResource GoodBrush}"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Flexible centre dashboard -->
        <Grid x:Name="DashboardMain"
              Grid.Column="1"
              Padding="8,8,12,8"
              Background="{StaticResource ShellBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="114"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Four KPI cards -->

            <Grid x:Name="MetricCards"
                  Grid.Row="0"
                  ColumnSpacing="8"
                  Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="ActiveJobsMetric"
                        Grid.Column="0"
                        Padding="10,8"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="ACTIVE JOBS"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10"/>
                        <Grid Grid.Row="1">
                            <TextBlock Text="3"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="◈"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="#17A67D"
                                       FontSize="24"/>
                        </Grid>
                        <TextBlock Grid.Row="2"
                                   Text="+2 from yesterday"
                                   Foreground="{StaticResource GoodBrush}"
                                   FontSize="11"/>
                    </Grid>
                </Border>

                <Border x:Name="QueuedJobsMetric"
                        Grid.Column="1"
                        Padding="10,8"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="QUEUED JOBS"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10"/>
                        <Grid Grid.Row="1">
                            <TextBlock Text="12"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="⌛"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="20"/>
                        </Grid>
                        <TextBlock Grid.Row="2"
                                   Text="Est. 1h 24m"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"/>
                    </Grid>
                </Border>

                <Border x:Name="AssetsProcessedMetric"
                        Grid.Column="2"
                        Padding="10,8"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="ASSETS PROCESSED"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10"/>
                        <TextBlock Grid.Row="1"
                                   Text="428"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2"
                                   Text="+18% this week"
                                   Foreground="{StaticResource GoodBrush}"
                                   FontSize="11"/>
                    </Grid>
                </Border>

                <Border x:Name="WorkerHealthMetric"
                        Grid.Column="3"
                        Padding="10,8"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="WORKER HEALTH"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10"/>
                        <TextBlock Grid.Row="1"
                                   Text="4 / 5"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    Spacing="5">
                            <Border Width="7"
                                    Height="7"
                                    Background="{StaticResource GoodBrush}"
                                    CornerRadius="4"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="Healthy"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Three parallel content columns -->
            <Grid Grid.Row="1"
                  Margin="0,8,0,0"
                  ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.13*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.05*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="RecentActivityPanel"
                        Grid.Column="0"
                        Padding="11"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Spacing="-1">
                                <TextBlock Text="Recent Activity"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="15"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Latest changes across this workspace"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="10"/>
                            </StackPanel>
                            <TextBlock Text="View All"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="10"/>
                        </Grid>

                        <Grid Grid.Row="1"
                              RowSpacing="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="◷"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="-1">
                                    <TextBlock Text="Recent Activity"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="12"/>
                                    <TextBlock Text="Groundforge Bases · export completed"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="10"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="7" Height="7" Background="{StaticResource GoodBrush}" CornerRadius="4"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="-1">
                                    <TextBlock Text="Procedural Ruin Wall completed" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                                    <TextBlock Text="Processed 48,221 triangles in 1.8s" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="7" Height="7" Background="{StaticResource WarningBrush}" CornerRadius="4"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="-1">
                                    <TextBlock Text="Noise Displace job started" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                                    <TextBlock Text="Project: Ancient Ruins" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="7" Height="7" Background="#4297C7" CornerRadius="4"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="-1">
                                    <TextBlock Text="Asset imported" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                                    <TextBlock Text="ruin_wall_01.fbx (12.4 MB)" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="7" Height="7" Background="{StaticResource GoodBrush}" CornerRadius="4"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="-1">
                                    <TextBlock Text="Worker W-01 back online" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                                    <TextBlock Text="Hardware check complete" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="7" Height="7" Background="{StaticResource GoodBrush}" CornerRadius="4"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="-1">
                                    <TextBlock Text="Batch processing completed" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                                    <TextBlock Text="12 assets processed in 3m 12s" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="7" Height="7" Background="#4297C7" CornerRadius="4"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="-1">
                                    <TextBlock Text="Project updated" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                                    <TextBlock Text="Ruin Environment v2" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="7" Height="7" Background="{StaticResource DangerBrush}" CornerRadius="4"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="-1">
                                    <TextBlock Text="Worker W-02 offline" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                                    <TextBlock Text="Connection lost" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="RecentProjectsPanel"
                        Grid.Column="1"
                        Padding="11"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Text="□"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="14"/>
                                <TextBlock Text="Recent Projects"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="15"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="View All"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="10"/>
                        </Grid>

                        <Grid Grid.Row="1"
                              RowSpacing="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Padding="6" Background="{StaticResource ElevatedBrush}" CornerRadius="5">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                                    <Border Height="64" Background="#5B4936" CornerRadius="3">
                                        <TextBlock Text="RUIN" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#CDBA9B" FontSize="11"/>
                                    </Border>
